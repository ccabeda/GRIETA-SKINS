{
    "name": "grieta-skins",
    "version": "1.0.0",
    "private": true,
    "description": "Catálogo educativo de skins de League of Legends",
    "scripts": {
        "dev": "node server.cjs",
        "build": "node scripts/build.js",
        "preview": "node server.cjs --preview",
        "prices:update": "node scripts/update-prices.js",
        "lore:update": "node scripts/update-lore.js",
        "data:update": "node scripts/update-data.js",
        "check": "node scripts/check.cjs",
        "test": "node --test tests/*.test.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.9"
    }
}
